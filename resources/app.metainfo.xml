<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.tihulu.ClipboardManager</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Tihulu Clipboard Manager</name>
  <summary>COSMIC clipboard manager with visible erase-all controls</summary>
  <description>
    <p>Tihulu Clipboard Manager is a COSMIC panel applet for clipboard history.</p>
    <p>The primary design goal is keeping destructive cleanup easy to find: Clear All / Erase All is visible in the main popup.</p>
  </description>
  <icon type="remote" width="64" height="64" scale="1">
    https://github.com/Tihulu/tihulu-clipboard-manager/raw/main/resources/icon.svg
  </icon>
  <url type="vcs-browser">https://github.com/Tihulu/tihulu-clipboard-manager</url>
  <launchable type="desktop-id">io.github.tihulu.ClipboardManager.desktop</launchable>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binaries>
      <binary>tihulu-clipboard-manager</binary>
    </binaries>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <categories>
    <category>COSMIC</category>
  </categories>
  <keywords>
    <keyword>COSMIC</keyword>
    <keyword>Clipboard</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
</component>
